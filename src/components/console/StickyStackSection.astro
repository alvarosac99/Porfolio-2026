---
---

<div class="stack-wrap relative [perspective:1600px]">
    <slot />
</div>

<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    function initStack(root: HTMLElement) {
        const wrappers = gsap.utils.toArray<HTMLElement>('.stack-wrapper', root);
        if (wrappers.length < 2) return;

        wrappers.forEach((wrapper, i) => {
            const panel = wrapper.querySelector<HTMLElement>('.stack-panel');
            if (!panel) return;

            gsap.set(panel, { zIndex: i, transformOrigin: 'top center' });

            if (i === wrappers.length - 1) return;

            const tl = gsap.timeline({
                scrollTrigger: {
                    trigger: wrapper,
                    start: 'top top',
                    end: 'bottom bottom',
                    scrub: true,
                },
            });
            tl.to(panel, { duration: 1 });
            tl.to(panel, {
                rotationX: -28,
                z: -500,
                scale: 0.82,
                opacity: 0,
                ease: 'none',
                duration: 1,
            });
        });
    }

    function init() {
        const root = document.querySelector<HTMLElement>('.stack-wrap');
        if (!root) return;

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReducedMotion) return;

        ScrollTrigger.matchMedia({
            '(min-width: 768px)': () => initStack(root),
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
</script>

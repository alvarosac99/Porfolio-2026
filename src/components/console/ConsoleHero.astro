---
import NameHero from '../react/NameHero.jsx';
import RoleRotator from '../react/RoleRotator.jsx';
---

<section id="hero" class="flex items-center justify-between px-5 md:px-10 lg:px-20 xl:px-[max(120px,calc((100vw-1400px)/2))] w-full min-h-[auto] md:h-[500px] py-10 md:py-0">
    <div class="flex flex-col md:flex-row items-center justify-between gap-10 md:gap-[60px] w-full">
        <!-- Left: Intro -->
        <div class="flex flex-col gap-6 items-start w-full md:flex-1">
            <!-- Name -->
            <div class="space-y-0 text-left w-full">
                <span class="text-[var(--color-accent)] font-mono text-sm md:hidden block mb-4">&gt; hola, soy</span>
                <NameHero client:load />
            </div>

            <!-- Description -->
            <div class="flex flex-col gap-2">
                <p data-scramble class="font-body text-[var(--color-text-muted)] text-base leading-[1.6] max-w-[520px]">
                    // desarrollador de IA generativa (RAG, LLMs) y cloud. de la arquitectura al despliegue, en producción
                </p>
                <div class="flex items-center gap-2 font-mono text-sm">
                    <span class="text-[var(--color-text-muted)]">modo:</span>
                    <RoleRotator client:load />
                </div>
            </div>

            <!-- CTAs -->
            <div class="flex flex-col md:flex-row gap-3 pt-2 w-full md:w-auto">
                <a href="#projects" class="cursor-target w-full md:w-auto flex items-center justify-center bg-[var(--color-accent)] text-[#0D0B0E] px-7 py-3.5 font-mono text-sm font-medium hover:opacity-90 active:scale-[0.97] transition-[opacity,transform] duration-150">
                    $ ver_proyectos
                </a>
                <a href="/cv.pdf" target="_blank" download class="cursor-target w-full md:w-auto flex items-center justify-center border border-[var(--color-stroke)] text-[var(--color-text)] px-7 py-3.5 font-mono text-sm hover:border-[var(--color-text)] hover:text-[var(--color-text)] active:scale-[0.97] transition-[color,border-color,transform] duration-150">
                    $ descargar_cv
                </a>
            </div>

            <!-- Redes -->
            <div class="flex items-center gap-4 pt-1">
                <a href="https://github.com/alvarosac99" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="cursor-target flex items-center justify-center w-10 h-10 border border-[var(--color-stroke)] text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:border-[var(--color-text)] transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                </a>
                <a href="https://linkedin.com/in/sebastián-acosta-cortizas" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="cursor-target flex items-center justify-center w-10 h-10 border border-[var(--color-stroke)] text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:border-[var(--color-text)] transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                </a>
            </div>
        </div>

        <!-- Right: Terminal -->
        <div class="w-full md:w-[520px] h-auto md:h-[440px] flex-shrink-0 mt-6 md:mt-0">
            <div class="bg-[var(--color-surface)] border border-[var(--color-stroke-secondary)] overflow-hidden w-full h-full flex flex-col shadow-2xl">
                <!-- Header -->
                <div class="bg-[var(--color-surface-dark)] px-4 h-[36px] border-b border-[var(--color-stroke-secondary)] flex items-center gap-2">
                    <div class="flex gap-2 mr-auto">
                        <div class="w-2.5 h-2.5 rounded-full bg-[#EF4444]"></div>
                        <div class="w-2.5 h-2.5 rounded-full bg-[#F59E0B]"></div>
                        <div class="w-2.5 h-2.5 rounded-full bg-[#10B981]"></div>
                    </div>
                    <div class="text-[var(--color-text-muted-secondary)] text-xs font-mono">  ~/porfolio</div>
                </div>

                <!-- Body -->
                <div class="p-5 space-y-1.5 font-mono text-[13px] md:text-[16px] flex-1 flex flex-col">
                    <!-- Cmd 1 -->
                    <div class="text-[var(--color-accent)]">$ whoami</div>
                    <div class="text-[var(--color-text)] font-body pb-2.5">sebas</div>

                    <!-- Cmd 2 -->
                    <div class="text-[var(--color-accent)]">$ cat about.txt</div>
                    <div class="text-[var(--color-text)] font-body pb-2.5 max-w-[370px]">desarrollador | consultor ti @ castroalonso</div>

                    <!-- Cmd 3 -->
                    <div class="text-[var(--color-accent)]">$ ls skills/</div>
                    <div class="text-[#06B6D4] font-body max-w-[370px]">java  python  django  react  sql  docker</div>
                    <div class="text-[#06B6D4] font-body pb-2.5 max-w-[370px]">linux  cloudflare  mantenimiento  soporte</div>

                    <!-- Cursor -->
                    <div class="flex gap-2 mt-auto pt-2">
                        <span class="text-[var(--color-accent)]">&gt;</span>
                        <span class="text-[var(--color-accent)] animate-pulse">_</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

---
---

<section id="projects" class="py-8 md:py-[60px] px-5 md:px-10 lg:px-20 xl:px-[120px] w-full border-t border-[var(--color-stroke)]">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 mb-8">
        <div class="flex items-center gap-3">
            <span class="font-mono font-bold text-[32px] text-[var(--color-accent)]">&gt;</span>
            <h2 class="font-mono font-bold text-[28px] text-[var(--color-text)]">proyectos</h2>
        </div>
        <p class="font-mono text-xs text-[var(--color-accent)]">
            $ ls ~/proyectos/
        </p>
    </div>

    <div class="flex flex-col gap-6">
        <!-- Row 1: Full Width Project - Games -->
        <a href="/projects/games" class="block w-full border border-[var(--color-stroke)] group hover:border-[var(--color-accent)] transition-colors backdrop-blur-sm" style="background-color: color-mix(in srgb, var(--color-surface), transparent 70%);">
            <div class="h-[200px] w-full bg-[#050505] relative overflow-hidden flex items-center justify-center border-b border-[var(--color-stroke)] group-hover:border-[var(--color-accent)]/50 transition-colors">
                <!-- Imagen de fondo (humo/fuego) -->
                <img src="/assets/games/img-2.jpg" alt="Fondo GameS" loading="lazy" class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:opacity-90 transition-opacity duration-700 mix-blend-screen" />
                
                <!-- Composición de Logos -->
                <div class="relative z-10 w-full h-full flex items-center justify-center transform group-hover:scale-110 transition-transform duration-700 ease-out">
                    <!-- S en el centro detrás o encima del texto GAMES -->
                    <img src="/assets/games/img-1.png" alt="Logo S" class="absolute h-[140px] w-[140px] opacity-20 group-hover:opacity-40 transition-opacity duration-500 blur-[2px] group-hover:blur-0" />
                    <!-- Texto GAMES principal -->
                    <img src="/assets/games/img-3.png" alt="GAMES Logo" class="relative z-20 h-16 md:h-20 object-contain drop-shadow-[0_5px_15px_rgba(255,60,0,0.4)]" />
                </div>
            </div>
            <div class="p-6 sm:px-8 md:px-10 md:py-8 flex flex-col gap-3">
                <span class="font-mono text-[28px] font-bold text-[var(--color-accent)]">01</span>
                <h3 class="font-mono font-bold text-base text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors">games/ — proyecto fin de curso</h3>
                <p class="font-body text-[13px] text-[var(--color-text-muted)] leading-[1.5] w-full">plataforma web integral para descubrir, organizar y gestionar videojuegos, con búsqueda avanzada, historial de precios y recomendaciones personalizadas.</p>
                <div class="flex gap-2 mt-2">
                    <span class="text-[11px] font-mono text-[#61DAFB]">[react]</span>
                    <span class="text-[11px] font-mono text-[#10B981]">[django]</span>
                    <span class="text-[11px] font-mono text-[#F59E0B]">[python]</span>
                    <span class="text-[11px] font-mono text-[#4479A1]">[mysql]</span>
                    <span class="text-[11px] font-mono text-[#DC382D]">[redis]</span>
                    <span class="text-[11px] font-mono text-[#2496ED]">[docker]</span>
                </div>
            </div>
        </a>

        <!-- Row 2: Split Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Left Project - Servidor VPS -->
            <div class="border border-[var(--color-stroke)] group hover:border-[var(--color-accent)] transition-colors flex flex-col backdrop-blur-sm" style="background-color: color-mix(in srgb, var(--color-surface), transparent 70%);">
                <div class="h-[200px] w-full bg-[#050505] relative overflow-hidden flex-shrink-0 flex items-center justify-center border-b border-[var(--color-stroke)] group-hover:border-[var(--color-accent)]/50 transition-colors group">
                    <!-- Fondo fibra de carbono (se aleja en hover) -->
                    <img src="/assets/zenith/zenith_carbon_bg.png" alt="Carbon Background" loading="lazy" class="absolute inset-0 w-full h-full object-cover opacity-80 scale-110 group-hover:scale-100 transition-all duration-700 ease-out" />
                    <!-- Texto (se acerca en hover) -->
                    <img src="/assets/zenith/zenith_text_black.png" alt="Zenith Seed Logo" loading="lazy" class="absolute inset-0 w-full h-full object-cover object-center mix-blend-screen scale-95 group-hover:scale-110 transition-all duration-700 ease-out" />
                    
                    <div class="absolute inset-0 bg-[var(--color-accent)]/5 mix-blend-overlay pointer-events-none group-hover:bg-transparent transition-colors duration-500"></div>
                </div>
                <div class="p-6 sm:px-8 md:px-10 md:py-8 flex flex-col gap-3 flex-grow">
                    <span class="font-mono text-[28px] font-bold text-[var(--color-accent)]">02</span>
                    <h3 class="font-mono font-bold text-base text-[var(--color-text)]">servidor vps/</h3>
                    <p class="font-body text-[13px] text-[var(--color-text-muted)] leading-[1.5] w-full">servidor privado virtual configurado desde cero con linux. hosting de aplicaciones web, servidor de minecraft y otros servicios.</p>
                    <div class="flex gap-2 mt-auto">
                        <span class="text-[11px] font-mono text-[var(--color-accent)]">[linux]</span>
                        <span class="text-[11px] font-mono text-[var(--color-accent)]">[docker]</span>
                        <span class="text-[11px] font-mono text-[#A855F7]">[nginx]</span>
                    </div>
                </div>
            </div>

            <!-- Right Project - Minecraft Server -->
            <a href="/projects/minecraft" class="block border border-[var(--color-stroke)] group hover:border-[var(--color-accent)] transition-colors flex flex-col backdrop-blur-sm" style="background-color: color-mix(in srgb, var(--color-surface), transparent 70%);">
                <div class="h-[200px] w-full bg-[#050505] relative overflow-hidden flex-shrink-0 flex items-center justify-center border-b border-[var(--color-stroke)] group-hover:border-[var(--color-accent)]/50 transition-colors group">
                    <!-- Fondo base (Luminoso pero oscuro que se aleja) sin opacidades ni gradientes CSS -->
                    <img src="/assets/minecraft/minecraft_bg_luminous.png" alt="Minecraft Night Background" loading="lazy" class="absolute inset-0 w-full h-full object-cover opacity-100 scale-110 group-hover:scale-100 transition-all duration-700 ease-out" />
                    

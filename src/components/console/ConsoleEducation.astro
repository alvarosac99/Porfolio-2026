---
---

<section id="education" class="stack-wrapper w-full border-t border-[var(--color-stroke)] md:min-h-[200dvh]">
    <div class="stack-panel md:sticky md:top-0 py-8 md:py-[60px] px-5 md:px-10 lg:px-20 xl:px-[120px] w-full md:min-h-[100dvh] md:flex md:flex-col md:justify-start md:pt-24">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 mb-8">
        <div class="flex items-center gap-3">
            <span class="font-mono font-bold text-[32px] text-[var(--color-accent)]">&gt;</span>
            <h2 class="font-mono font-bold text-[28px] text-[var(--color-text)]">educación</h2>
        </div>
        <p class="font-mono text-xs text-[var(--color-accent)]">
            $ cat cv.pdf | grep titulo
        </p>
    </div>

    <!-- Education Cards -->
    <div data-stagger=":scope > div" class="grid grid-cols-1 lg:grid-cols-[2fr_1fr] gap-6">
        <!-- Education 1 - DAM (Featured) -->
        <div class="flex flex-col justify-center gap-4 p-8 lg:p-10 border border-[var(--color-accent)] backdrop-blur-sm" style="background-color: color-mix(in srgb, var(--color-surface), transparent 40%);">
            <span class="font-mono text-xs text-[var(--color-accent)]">[grado superior]</span>
            <h3 class="font-mono font-bold text-xl md:text-2xl text-[var(--color-text)] leading-[1.3]">Desarrollo de Aplicaciones Multiplataforma</h3>
            <p class="font-body text-sm text-[var(--color-text-muted)]">I.E.S. Doctor Fleming, Oviedo</p>
        </div>

        <!-- Education 2 - Bachillerato -->
        <div class="flex flex-col justify-center gap-3 p-6 border border-[var(--color-stroke)] hover:border-[var(--color-accent)] transition-colors backdrop-blur-sm" style="background-color: color-mix(in srgb, var(--color-surface), transparent 70%);">
            <span class="font-mono text-xs text-[var(--color-text-muted)]">[bachillerato]</span>
            <h3 class="font-mono font-bold text-sm text-[var(--color-text)]">Bachillerato de Humanidades</h3>
            <p class="font-body text-[13px] text-[var(--color-text-muted)]">I.E.S. Pérez de Ayala, Oviedo</p>
        </div>
    </div>
    </div>
</section>

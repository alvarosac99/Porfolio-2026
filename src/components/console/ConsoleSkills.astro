---
---

<section id="skills" class="py-8 md:py-[60px] px-5 md:px-10 lg:px-20 xl:px-[max(120px,calc((100vw-1400px)/2))] w-full border-t border-[var(--color-stroke)]">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 mb-8">
        <div class="flex items-center gap-3">
            <span class="font-mono font-bold text-[32px] text-[var(--color-accent)]">&gt;</span>
            <h2 class="font-mono font-bold text-[28px] text-[var(--color-text)]">aptitudes</h2>
        </div>
        <p class="font-mono text-xs text-[var(--color-accent)]">
            $ apt list --installed
        </p>
    </div>

    <!-- Skills Grid -->
    <div data-stagger=":scope > div" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-[1.5fr_1fr] gap-6 md:gap-10">
        <!-- Left Column: Técnicas -->
        <div class="flex flex-col gap-5 md:gap-6">
            <span class="font-mono text-sm md:text-base text-[var(--color-text-title)]">// técnicas</span>

            <!-- Programming -->
            <div class="flex flex-col gap-4 md:gap-5 p-6 md:p-8 border border-[var(--color-stroke)] hover:border-[var(--color-accent)] transition-colors backdrop-blur-sm" style="background-color: color-mix(in srgb, var(--color-surface), transparent 40%);">
                <span class="font-mono text-[14px] md:text-[16px] text-[var(--color-accent)]">$ apt-get programming</span>

                <span class="font-mono text-[11px] text-[var(--color-text-muted)]">lenguajes</span>
                <div class="flex flex-wrap gap-2.5 md:gap-3">
                    <span class="inline-flex items-center gap-2 md:gap-2.5 px-3 py-1.5 md:px-4 md:py-2 border border-[var(--color-stroke)] font-body text-[14px] md:text-[15px] font-medium text-[var(--color-text)] hover:bg-[var(--color-stroke)]/30 transition-colors">
                        <img src="/icons/devicon/python.svg" alt="Python" class="w-5 h-5 md:w-6 md:h-6" />
                        python
                    </span>
                    <span class="inline-flex items-center gap-2 md:gap-2.5 px-3 py-1.5 md:px-4 md:py-2 border border-[var(--color-stroke)] font-body text-[14px] md:text-[15px] font-medium text-[var(--color-text)] hover:bg-[var(--color-stroke)]/30 transition-colors">
                        <img src="/icons/devicon/php.svg" alt="PHP" class="w-5 h-5 md:w-6 md:h-6" />
                        php
                    </span>
                    <span class="inline-flex items-center gap-2 md:gap-2.5 px-3 py-1.5 md:px-4 md:py-2 border border-[var(--color-stroke)] font-body text-[14px] md:text-[15px] font-medium text-[var(--color-text)] hover:bg-[var(--color-stroke)]/30 transition-colors">
                        <img src="/icons/devicon/javascript.svg" alt="JavaScript" class="w-5 h-5 md:w-6 md:h-6 rounded-sm" />
                        js / typescript
                    </span>
                    <span class="inline-flex items-center gap-2 md:gap-2.5 px-3 py-1.5 md:px-4 md:py-2 border border-[var(--color-stroke)] font-body text-[14px] md:text-[15px] font-medium text-[var(--color-text)] hover:bg-[var(--color-stroke)]/30 transition-colors">
                        <img src="/icons/devicon/html5.svg" alt="HTML/CSS" class="w-5 h-5 md:w-6 md:h-6" />
                        html/css
                    </span>
                    <span class="inline-flex items-center gap-2 md:gap-2.5 px-3 py-1.5 md:px-4 md:py-2 border border-[var(--color-stroke)] font-body text-[14px] md:text-[15px] font-medium text-[var(--color-text)] hover:bg-[var(--color-stroke)]/30 transition-colors">
                        <img src="/icons/devicon/mysql.svg" alt="SQL" class="w-5 h-5 md:w-6 md:h-6" />
                        sql
                    </span>
                    <span class="inline-flex items-center gap-2 md:gap-2.5 px-3 py-1.5 md:px-4 md:py-2 border border-[var(--color-stroke)] font-body text-[14px] md:text-[15px] font-medium text-[var(--color-text)] hover:bg-[var(--color-stroke)]/30 transition-colors">
                        <img src="/icons/devicon/java.svg" alt="Java" class="w-5 h-5 md:w-6 md:h-6" />
                        java
                    </span>
                </div>

                <span class="font-mono text-[11px] text-[var(--color-text-muted)]">frameworks / librerías</span>
                <div class="flex flex-wrap gap-2.5 md:gap-3">
                    <span class="inline-flex items-center gap-2 md:gap-2.5 px-3 py-1.5 md:px-4 md:py-2 border border-[var(--color-stroke)] font-body text-[14px] md:text-[15px] font-medium text-[var(--color-text)] hover:bg-[var(--color-stroke)]/30 transition-colors">
                        <img src="/icons/devicon/django.svg" alt="Django" class="w-5 h-5 md:w-6 md:h-6 invert" />
                        django
                    </span>
                    <span class="inline-flex items-center gap-2 md:gap-2.5 px-3 py-1.5 md:px-4 md:py-2 border border-[var(--color-stroke)] font-body text-[14px] md:text-[15px] font-medium text-[var(--color-text)] hover:bg-[var(--color-stroke)]/30 transition-colors">
                        <img src="/icons/devicon/react.svg" alt="React" class="w-5 h-5 md:w-6 md:h-6" />
                        react
                    </span>
                    <span class="inline-flex items-center gap-2 md:gap-2.5 px-3 py-1.5 md:px-4 md:py-2 border border-[var(--color-stroke)] font-body text-[14px] md:text-[15px] font-medium text-[var(--color-text)] hover:bg-[var(--color-stroke)]/30 transition-colors">
                        <img src="/icons/devicon/quarkus.svg" alt="Quarkus" class="w-5 h-5 md:w-6 md:h-6" />
                        quarkus
                    </span>
                    <span class="inline-flex items-center gap-2 md:gap-2.5 px-3 py-1.5 md:px-4 md:py-2 border border-[var(--color-stroke)] font-body text-[14px] md:text-[15px] font-medium text-[var(--color-text)] hover:bg-[var(--color-stroke)]/30 transition-colors">
                        <img src="/icons/devicon/fastapi.svg" alt="FastAPI" class="w-5 h-5 md:w-6 md:h-6" />
                        fastapi
                    </span>
                    <span class="inline-flex items-center gap-2 md:gap-2.5 px-3 py-1.5 md:px-4 md:py-2 border border-[var(--color-stroke)] font-body text-[14px] md:text-[15px] font-medium text-[var(--color-text)] hover:bg-[var(--color-stroke)]/30 transition-colors">
                        <img src="/icons/devicon/huggingface.svg" alt="HuggingFace" class="w-5 h-5 md:w-6 md:h-6 invert" />
                        huggingface
                    </span>
                </div>

                <span class="font-mono text-[11px] text-[var(--color-text-muted)]">bases de datos</span>
                <div class="flex flex-wrap gap-2.5 md:gap-3">
                    <span class="inline-flex items-center gap-2 md:gap-2.5 px-3 py-1.5 md:px-4 md:py-2 border border-[var(--color-stroke)] font-body text-[14px] md:text-[15px] font-medium text-[var(--color-text)] hover:bg-[var(--color-stroke)]/30 transition-colors">
                        <img src="/icons/devicon/postgresql.svg" alt="PostgreSQL" class="w-5 h-5 md:w-6 md:h-6" />
                        postgresql
                    </span>
                    <span class="inline-flex items-center gap-2 md:gap-2.5 px-3 py-1.5 md:px-4 md:py-2 border border-[var(--color-stroke)] font-body text-[14px] md:text-[15px] font-medium text-[var(--color-text)] hover:bg-[var(--color-stroke)]/30 transition-colors">
                        <img src="/icons/devicon/mysql.svg" alt="MySQL" class="w-5 h-5 md:w-6 md:h-6" />
                        mysql
                    </span>
                    <span class="inline-flex items-center gap-2 md:gap-2.5 px-3 py-1.5 md:px-4 md:py-2 border border-[var(--color-stroke)] font-body text-[14px] md:text-[15px] font-medium text-[var(--color-text)] hover:bg-[var(--color-stroke)]/30 transition-colors">
                        <img src="/icons/devicon/redis.svg" alt="Redis" class="w-5 h-5 md:w-6 md:h-6" />
                        redis
                    </span>
                </div>

                <span class="font-mono text-[11px] text-[var(--color-text-muted)]">herramientas</span>
                <div class="flex flex-wrap gap-2.5 md:gap-3">
                    <span class="inline-flex items-center gap-2 md:gap-2.5 px-3 py-1.5 md:px-4 md:py-2 border border-[var(--color-stroke)] font-body text-[14px] md:text-[15px] font-medium text-[var(--color-text)] hover:bg-[var(--color-stroke)]/30 transition-colors">
                        <img src="/icons/devicon/git.svg" alt="Git" class="w-5 h-5 md:w-6 md:h-6" />
                        git
                    </span>
                    <span class="inline-flex items-center gap-2 md:gap-2.5 px-3 py-1.5 md:px-4 md:py-2 border border-[var(--color-stroke)] font-body text-[14px] md:text-[15px] font-medium text-[var(--color-text)] hover:bg-[var(--color-stroke)]/30 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 md:w-6 md:h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" x2="20" y1="19" y2="19"/></svg>
                        ssh
                    </span>
                    <span class="inline-flex items-center gap-2 md:gap-2.5 px-3 py-1.5 md:px-4 md:py-2 border border-[var(--color-stroke)] font-body text-[14px] md:text-[15px] font-medium text-[var(--color-text)] hover:bg-[var(--color-stroke)]/30 transition-colors">
                        <img src="/icons/devicon/pytest.svg" alt="pytest" class="w-5 h-5 md:w-6 md:h-6" />
                        pytest
                    </span>
                    <span class="inline-flex items-center gap-2 md:gap-2.5 px-3 py-1.5 md:px-4 md:py-2 border border-[var(--color-stroke)] font-body text-[14px] md:text-[15px] font-medium text-[var(--color-text)] hover:bg-[var(--color-stroke)]/30 transition-colors">
                        <img src="/icons/devicon/playwright.svg" alt="Playwright" class="w-5 h-5 md:w-6 md:h-6" />
                        playwright
                    </span>
                    <span class="inline-flex items-center gap-2 md:gap-2.5 px-3 py-1.5 md:px-4 md:py-2 border border-[var(--color-stroke)] font-body text-[14px] md:text-[15px] font-medium text-[var(--color-text)] hover:bg-[var(--color-stroke)]/30 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 md:w-6 md:h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="19" r="3"/><path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15"/><circle cx="18" cy="5" r="3"/></svg>
                        openrouter
                    </span>
                </div>
            </div>

            <!-- IA / Machine Learning -->
            <div class="flex flex-col gap-4 md:gap-5 p-6 md:p-8 border border-[var(--color-accent)]/60 hover:border-[var(--color-accent)] transition-colors backdrop-blur-sm" style="background-color: color-mix(in srgb, var(--color-surface), transparent 40%);">
                <span class="font-mono text-[14px] md:text-[16px] text-[var(--color-accent)]">$ apt-get ia</span>
                <p class="font-body text-[14px] md:text-[16px] text-[var(--color-text)] leading-[1.8] font-medium">RAG propio (chunking, embeddings, retrieval) · LLMs multi-modelo vía OpenRouter · fine-tuning (RoBERTuito) y clasificación · observabilidad LLM con OpenTelemetry</p>
            </div>

            <!-- Systems -->
            <div class="flex flex-col gap-4 md:gap-5 p-6 md:p-8 border border-[var(--color-stroke)] hover:border-[var(--color-accent)] transition-colors backdrop-blur-sm" style="background-color: color-mix(in srgb, var(--color-surface), transparent 40%);">
                <span class="font-mono text-[14px] md:text-[16px] text-[var(--color-accent)]">$ apt-get systems</span>
                <div class="flex flex-wrap gap-2.5 md:gap-3">
                    <span class="inline-flex items-center gap-2 md:gap-2.5 px-3 py-1.5 md:px-4 md:py-2 border border-[var(--color-stroke)] font-body text-[14px] md:text-[15px] font-medium text-[var(--color-text)] hover:bg-[var(--color-stroke)]/30 transition-colors">
                        <img src="/icons/devicon/linux.svg" alt="Linux" class="w-5 h-5 md:w-6 md:h-6" />
                        linux
                    </span>
                    <span class="inline-flex items-center gap-2 md:gap-2.5 px-3 py-1.5 md:px-4 md:py-2 border border-[var(--color-stroke)] font-body text-[14px] md:text-[15px] font-medium text-[var(--color-text)] hover:bg-[var(--color-stroke)]/30 transition-colors">
                        <img src="/icons/devicon/docker.svg" alt="Docker" class="w-5 h-5 md:w-6 md:h-6" />
                        docker
                    </span>
                    <span class="inline-flex items-center gap-2 md:gap-2.5 px-3 py-1.5 md:px-4 md:py-2 border border-[var(--color-stroke)] font-body text-[14px] md:text-[15px] font-medium text-[var(--color-text)] hover:bg-[var(--color-stroke)]/30 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 md:w-6 md:h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"/><rect width="20" height="8" x="2" y="14" rx="2" ry="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/></svg>
                        servidores
                    </span>
                    <span class="inline-flex items-center gap-2 md:gap-2.5 px-3 py-1.5 md:px-4 md:py-2 border border-[var(--color-stroke)] font-body text-[14px] md:text-[15px] font-medium text-[var(--color-text)] hover:bg-[var(--color-stroke)]/30 transition-colors">
                        <img src="/icons/devicon/nginx.svg" alt="Nginx" class="w-5 h-5 md:w-6 md:h-6" />
                        nginx
                    </span>
                    <span class="inline-flex items-center gap-2 md:gap-2.5 px-3 py-1.5 md:px-4 md:py-2 border border-[var(--color-stroke)] font-body text-[14px] md:text-[15px] font-medium text-[var(--color-text)] hover:bg-[var(--color-stroke)]/30 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 md:w-6 md:h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 7h.01"/><path d="M17 7h.01"/><path d="M7 17h.01"/><path d="M17 17h.01"/></svg>
                        virtualización
                    </span>
                    <span class="inline-flex items-center gap-2 md:gap-2.5 px-3 py-1.5 md:px-4 md:py-2 border border-[var(--color-stroke)] font-body text-[14px] md:text-[15px] font-medium text-[var(--color-text)] hover:bg-[var(--color-stroke)]/30 transition-colors">
                        <img src="/icons/devicon/cloudflare.svg" alt="Cloudflare" class="w-5 h-5 md:w-6 md:h-6" />
                        cloudflare
                    </span>
                    <span class="inline-flex items-center gap-2 md:gap-2.5 px-3 py-1.5 md:px-4 md:py-2 border border-[var(--color-stroke)] font-body text-[14px] md:text-[15px] font-medium text-[var(--color-text)] hover:bg-[var(--color-stroke)]/30 transition-colors">
                        <img src="/icons/devicon/amazonwebservices.svg" alt="AWS" class="w-5 h-5 md:w-6 md:h-6 invert" />
                        aws
                    </span>
                </div>
            </div>

            <!-- Hardware -->
            <div class="flex flex-col gap-4 md:gap-5 p-6 md:p-8 border border-[var(--color-stroke)] hover:border-[var(--color-accent)] transition-colors backdrop-blur-sm" style="background-color: color-mix(in srgb, var(--color-surface), transparent 40%);">
                <span class="font-mono text-[14px] md:text-[16px] text-[var(--color-accent)]">$ apt-get hardware</span>
                <p class="font-body text-[14px] md:text-[16px] text-[var(--color-text)] leading-[1.8] font-medium">montaje y diagnóstico de equipos · soporte técnico · edición de vídeo</p>
            </div>
        </div>

        <!-- Right Column: Personales -->
        <div class="flex flex-col gap-5 md:gap-6">
            <span class="font-mono text-sm md:text-base text-[var(--color-text-title)]">// personales</span>

            <div class="flex flex-col justify-around gap-6 p-6 md:p-8 border border-[var(--color-stroke)] hover:border-[var(--color-accent)] transition-colors backdrop-blur-sm h-full" style="background-color: color-mix(in srgb, var(--color-surface), transparent 40%);">
                <div class="flex items-center gap-4">
                    <span class="w-2.5 h-2.5 md:w-3 md:h-3 rounded-full bg-[var(--color-accent)] flex-shrink-0"></span>
                    <span class="font-body text-[15px] md:text-[17px] font-medium text-[var(--color-text)]">sociable &amp; comunicación efectiva</span>
                </div>
                <div class="flex items-center gap-4">
                    <span class="w-2.5 h-2.5 md:w-3 md:h-3 rounded-full bg-[var(--color-accent)] flex-shrink-0"></span>
                    <span class="font-body text-[15px] md:text-[17px] font-medium text-[var(--color-text)]">capacidad de adaptación</span>
                </div>
                <div class="flex items-center gap-4">
                    <span class="w-2.5 h-2.5 md:w-3 md:h-3 rounded-full bg-[var(--color-accent)] flex-shrink-0"></span>
                    <span class="font-body text-[15px] md:text-[17px] font-medium text-[var(--color-text)]">motivado por aprender</span>
                </div>
                <div class="flex items-center gap-4">
                    <span class="w-2.5 h-2.5 md:w-3 md:h-3 rounded-full bg-[var(--color-accent)] flex-shrink-0"></span>
                    <span class="font-body text-[15px] md:text-[17px] font-medium text-[var(--color-text)]">experiencia dando formaciones</span>
                </div>
                <div class="flex items-center gap-4">
                    <span class="w-2.5 h-2.5 md:w-3 md:h-3 rounded-full bg-[var(--color-accent)] flex-shrink-0"></span>
                    <span class="font-body text-[15px] md:text-[17px] font-medium text-[var(--color-text)]">resiliencia &amp; trabajo en equipo</span>
                </div>
            </div>
        </div>
    </div>
</section>

---
import ThemeTrigger from './ThemeTrigger.astro';
import ThemeDropdown from './ThemeDropdown.astro';
---

<header class="h-14 md:h-[72px] px-5 md:px-[60px] flex items-center justify-between w-full sticky top-0 z-50 bg-[var(--color-bg)]/25 backdrop-blur-sm">
    <a href="/" class="flex items-center gap-3 group">
        <span class="font-soft font-semibold text-lg text-[var(--color-text)]"><span class="text-[var(--color-text)]">Zenith</span><span class="text-[var(--color-accent)]">Seed</span></span>
    </a>

    <div class="flex items-center relative">
        <ThemeTrigger />
        <ThemeDropdown />
    </div>
</header>

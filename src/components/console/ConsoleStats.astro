---
---

<section id="stats" class="py-8 md:py-[60px] px-5 md:px-10 lg:px-20 xl:px-[120px] w-full">
    <div class="flex flex-col gap-8 w-full">
        <!-- Header -->
        <div class="flex items-center justify-between w-full">
            <h2 class="font-mono text-xs text-[var(--color-text-title)]">// stats</h2>
        </div>

        <!-- Intro animada -->
        <p id="stats-intro" class="font-body text-[var(--color-text-muted)] text-sm md:text-base leading-[1.7] max-w-[640px]">
            llevo más de un año de experiencia en el sector, y siempre tengo algún proyecto entre manos. ahora mismo estoy aprendiendo modelaje 3d, antes fue montar un servidor desde cero, y en paralelo sigo metido en un proyecto de impacto social que todavía no puede salir a la luz. me comprometo a construir cosas que aporten algo real al mundo.
        </p>

        <!-- Stats Cards: asimétrico, una card destacada + dos apiladas -->
        <div data-stagger=".stat-card" class="grid grid-cols-1 md:grid-cols-[1.6fr_1fr] gap-6 w-full">
            <!-- Card 1: Años Experiencia (destacada) -->
            <div class="stat-card flex flex-col justify-between gap-6 p-8 md:p-10 border border-[var(--color-accent)] backdrop-blur-sm" style="background-color: color-mix(in srgb, var(--color-surface), transparent 40%);">
                <span class="font-mono text-xs text-[var(--color-text-muted)]">años_experiencia</span>
                <span data-counter="1+" class="font-mono text-[64px] md:text-[88px] font-bold text-[var(--color-text)] leading-none">1+</span>
                <span class="font-body text-sm text-[var(--color-accent)]">++ formación continua</span>
            </div>

            <!-- Columna derecha: Tecnologías + Servidores apiladas -->
            <div class="flex flex-col gap-6">
                <div class="stat-card flex-1 flex flex-col gap-3 p-6 border border-[var(--color-stroke)] hover:border-[var(--color-accent)] transition-colors backdrop-blur-sm" style="background-color: color-mix(in srgb, var(--color-surface), transparent 70%);">
                    <span class="font-mono text-xs text-[var(--color-text-muted)]">tecnologías</span>
                    <span data-counter="10+" class="font-mono text-[32px] font-bold text-[var(--color-text)]">10+</span>
                    <span class="font-body text-xs text-[var(--color-accent)]">++ python, django, react, docker...</span>
                </div>

                <div class="stat-card flex-1 flex flex-col gap-3 p-6 border border-[var(--color-stroke)] hover:border-[var(--color-accent)] transition-colors backdrop-blur-sm" style="background-color: color-mix(in srgb, var(--color-surface), transparent 70%);">
                    <span class="font-mono text-xs text-[var(--color-text-muted)]">servidores_activos</span>
                    <span class="font-mono text-[32px] font-bold text-[var(--color-text)]">1 VPS</span>
                    <span class="font-body text-xs text-[var(--color-accent)]">++ minecraft + web + más</span>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import { animate, stagger, onScroll, splitText } from 'animejs';

    function initIntro() {
        const el = document.getElementById('stats-intro');
        if (!el) return;

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReducedMotion) return;

        const { words } = splitText(el);

        animate(words, {
            opacity: [0, 1],
            translateY: [16, 0],
            delay: stagger(25),
            duration: 500,
            ease: 'outQuad',
            autoplay: onScroll({
                enter: 'bottom-=10% top',
                once: true,
            }),
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initIntro);
    } else {
        initIntro();
    }
</script>

---
import TechLoop from '../react/TechLoop.jsx';
---

<section id="stats" class="py-6 md:py-8 px-5 md:px-10 lg:px-20 xl:px-[max(120px,calc((100vw-1400px)/2))] w-full">
    <div class="flex flex-col gap-5 w-full">
        <!-- Header -->
        <div class="flex items-center justify-between w-full">
            <h2 class="font-mono text-xs text-[var(--color-text-title)]">// stats</h2>
        </div>

        <!-- Intro animada -->
        <p data-scramble class="font-body text-[var(--color-text-muted)] text-xs md:text-sm leading-[1.6] w-full">
            llevo más de un año de experiencia en el sector, y siempre tengo algún proyecto entre manos. ahora mismo estoy aprendiendo modelaje 3D, antes fue montar un servidor desde cero, y en paralelo sigo metido en un proyecto de impacto social. me comprometo a construir cosas que aporten algo real al mundo.
        </p>

        <!-- Stats Cards: asimétrico, una card destacada + dos apiladas -->
        <div data-stagger=".stat-card" class="flex flex-col md:flex-row gap-6 w-full">
            <!-- Card 1: Años Experiencia (destacada, ancho mínimo) -->
            <div class="stat-card flex flex-col justify-between gap-6 p-8 md:p-10 border border-[var(--color-accent)] backdrop-blur-sm md:w-fit" style="background-color: color-mix(in srgb, var(--color-surface), transparent 40%);">
                <span class="font-mono text-xs text-[var(--color-text-muted)] whitespace-nowrap">años_experiencia</span>
                <div class="flex items-end gap-4">
                    <span data-counter="1+" class="font-mono text-[64px] md:text-[88px] font-bold text-[var(--color-text)] leading-none">1+</span>
                </div>
            </div>

            <!-- Card 2: Tecnologías (ocupa el resto) -->
            <div class="stat-card flex flex-col justify-between gap-6 p-8 md:p-10 border border-[var(--color-stroke)] hover:border-[var(--color-accent)] transition-colors backdrop-blur-sm flex-1 min-w-0" style="background-color: color-mix(in srgb, var(--color-surface), transparent 70%);">
                <span class="font-mono text-xs text-[var(--color-text-muted)]">tecnologías</span>
                <div class="w-full overflow-hidden" style="height: 88px;">
                    <TechLoop client:visible />
                </div>
            </div>
        </div>
    </div>
</section>

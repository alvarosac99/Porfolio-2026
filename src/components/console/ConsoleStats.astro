---
---

<section id="stats" class="py-8 md:py-[60px] px-5 md:px-10 lg:px-20 xl:px-[120px] w-full">
    <div class="flex flex-col gap-8 w-full">
        <!-- Header -->
        <div class="flex items-center justify-between w-full">
            <h2 class="font-mono text-xs text-[var(--color-text-title)]">// stats</h2>
        </div>

        <!-- Stats Cards -->
        <div data-stagger=".stat-card" class="grid grid-cols-1 md:grid-cols-3 gap-6 w-full">
            <!-- Card 1: Años Experiencia -->
            <div class="stat-card flex flex-col gap-3 p-6 border border-[var(--color-stroke)] hover:border-[var(--color-accent)] transition-colors backdrop-blur-sm" style="background-color: color-mix(in srgb, var(--color-surface), transparent 70%);">
                <span class="font-mono text-xs text-[var(--color-text-muted)]">años_experiencia</span>
                <span data-counter="1+" class="font-mono text-[32px] font-bold text-[var(--color-text)]">1+</span>
                <span class="font-body text-xs text-[var(--color-accent)]">++ formación continua</span>
            </div>

            <!-- Card 2: Tecnologías -->
            <div class="stat-card flex flex-col gap-3 p-6 border border-[var(--color-stroke)] hover:border-[var(--color-accent)] transition-colors backdrop-blur-sm" style="background-color: color-mix(in srgb, var(--color-surface), transparent 70%);">
                <span class="font-mono text-xs text-[var(--color-text-muted)]">tecnologías</span>
                <span data-counter="10+" class="font-mono text-[32px] font-bold text-[var(--color-text)]">10+</span>
                <span class="font-body text-xs text-[var(--color-accent)]">++ python, django, react, docker...</span>
            </div>

            <!-- Card 3: Servidores Activos -->
            <div class="stat-card flex flex-col gap-3 p-6 border border-[var(--color-stroke)] hover:border-[var(--color-accent)] transition-colors backdrop-blur-sm" style="background-color: color-mix(in srgb, var(--color-surface), transparent 70%);">
                <span class="font-mono text-xs text-[var(--color-text-muted)]">servidores_activos</span>
                <span class="font-mono text-[32px] font-bold text-[var(--color-text)]">1 VPS</span>
                <span class="font-body text-xs text-[var(--color-accent)]">++ minecraft + web + más</span>
            </div>
        </div>
    </div>
</section>

---
import '@fontsource/jetbrains-mono';
import '@fontsource/jetbrains-mono/700.css';
import '@fontsource/ibm-plex-mono';
import '../styles/global.css';
import BackgroundAnimation from '../components/BackgroundAnimation.astro';
import PageTransition from '../components/PageTransition.astro';
import ScrollFX from '../components/ScrollFX.astro';
import CursorLayer from '../components/react/CursorLayer.jsx';

interface Props {
	title: string;
	showCursor?: boolean;
	background?: 'particles' | 'none';
}

const { title, showCursor = false, background = 'particles' } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth overscroll-none">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Porfolio de Álvaro Sebastián Acosta" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto+Flex:opsz,wdth,wght@8..144,25..151,100..1000&display=swap" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<!-- Anti-flash: aplicar tema guardado antes de que el navegador pinte -->
		<script is:inline>
			(function () {
				const theme = localStorage.getItem('theme') || 'favorite-dark';
				document.documentElement.setAttribute('data-theme', theme);
			})();
		</script>
	</head>
	<body class="text-[var(--color-text)] font-body antialiased selection:bg-[var(--color-accent)] selection:text-[var(--color-bg)]">
        <PageTransition />
        {background === 'particles' && <BackgroundAnimation />}
        <ScrollFX />
        {showCursor && (
            <CursorLayer
                client:load
                targetSelector=".cursor-target"
                spinDuration={2}
                hideDefaultCursor={true}
                parallaxOn={false}
                cursorColor="var(--color-text)"
                cursorColorOnTarget="var(--color-accent)"
            />
        )}
        <div class="min-h-screen flex flex-col relative z-10">
		    <slot />
        </div>
	</body>
</html>

---
import '../styles/blog.css';
import PageTransition from '../components/PageTransition.astro';
import BlogFooter from '../components/blog/BlogFooter.astro';

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="ZenithBlog, de Álvaro Sebastián Acosta" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>
    <body class="min-h-screen flex flex-col">
        <PageTransition />
        <slot />
        <BlogFooter />

        <dialog id="lightbox" class="lightbox"><img alt="" /></dialog>
        <script is:inline>
            const dlg = document.getElementById('lightbox');
            if (dlg) {
                const dimg = dlg.querySelector('img');
                document.addEventListener('click', (e) => {
                    if (e.target.matches('article figure img')) {
                        dimg.src = e.target.currentSrc || e.target.src;
                        dimg.classList.remove('zoomed');
                        dlg.showModal();
                    } else if (e.target === dimg) {
                        dimg.classList.toggle('zoomed');
                    } else if (dlg.open) {
                        dlg.close();
                    }
                });
            }
        </script>
    </body>
</html>

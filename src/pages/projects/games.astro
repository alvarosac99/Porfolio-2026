---
import ConsoleLayout from '../../layouts/ConsoleLayout.astro';
import TopBar from '../../components/console/TopBar.astro';
import DocHero from '../../components/console/DocHero.astro';
import DocFooter from '../../components/console/DocFooter.astro';
import ProjectSidebar from '../../components/react/ProjectSidebar.jsx';
import { marked } from 'marked';
import { createHighlighter } from 'shiki';

const highlighter = await createHighlighter({
  themes: ['poimandres', 'min-light'],
  langs: ['javascript', 'typescript', 'bash', 'json', 'yaml', 'markdown', 'html', 'css', 'python', 'java', 'sql', 'astro', 'vue', 'sh', 'txt', 'c', 'cpp', 'csharp', 'go', 'rust']
});

// Configurando marked para evitar warnings si no se pone esto
marked.use({
  async: false,
  pedantic: false,
  gfm: true,
});

const response = await fetch('https://raw.githubusercontent.com/alvarosac99/GameS/main/README.md');
let markdownContent = await response.text();

// Arreglar las rutas relativas de imágenes del README para que apunten al raw github
markdownContent = markdownContent.replace(/src="docs\/screenshots\//g, 'src="https://raw.githubusercontent.com/alvarosac99/GameS/main/docs/screenshots/');
markdownContent = markdownContent.replace(/\]\(docs\/screenshots\//g, '](https://raw.githubusercontent.com/alvarosac99/GameS/main/docs/screenshots/');

// Redirigir todos los links relativos de archivos a github
markdownContent = markdownContent.replace(/\]\((?!http|#|mailto:)(.*?)\)/g, '](https://github.com/alvarosac99/GameS/tree/main/$1)');
markdownContent = markdownContent.replace(/href="(?!http|#|mailto:)(.*?)"/g, 'href="https://github.com/alvarosac99/GameS/tree/main/$1"');

// Extraer cabeceras H2 para el menú lateral y ponerles IDs amigables
const headings: { text: string; id: string }[] = [];
const renderer = new marked.Renderer();

renderer.heading = function(obj) {
  const rawText = obj.text;
  const depth = obj.depth;
  // Parse inline markdown correctly for the visible heading (converts *text* to <em>text</em>, etc)
  const innerHtml = this.parser.parseInline(obj.tokens);
  
  // Limpiar HTML tags de texto crudo si los hay (iconos SVG)
  const cleanText = rawText.replace(/<[^>]*>?/gm, '').trim();
  const id = cleanText.toLowerCase().replace(/[^\w\u00C0-\u017F]+/g, '-').replace(/^-+|-+$/g, '');
  
  if (depth === 2 && cleanText.length > 0 && !cleanText.includes('Tabla de Contenidos')) {
      headings.push({ text: cleanText, id });
  }
  
  return `<h${depth} id="${id}" class="group flex whitespace-pre-wrap -ml-4 pl-4">${innerHtml}</h${depth}>\n`;
};

// Customizando el renderizador del código para parsear gráficos Mermaid y usar Shiki
renderer.code = function(obj) {
  const codeText = obj.text;
  const lang = obj.lang ? obj.lang.toLowerCase() : '';
  
  if (lang === 'mermaid') {
      const escapedText = codeText.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
      return `<div class="w-full relative my-8 bg-[var(--color-surface)] p-2 rounded-xl border border-[var(--color-stroke)] overflow-hidden"><div class="mermaid-container w-full h-[500px] flex justify-center items-center" data-src="${escapedText}"></div></div>\n`;
  }
  
  try {
    const validLang = highlighter.getLoadedLanguages().includes(lang) ? lang : 'txt';
    const highlighted = highlighter.codeToHtml(codeText, {
      lang: validLang,
      themes: { light: 'min-light', dark: 'poimandres' },
      defaultColor: false,
    });
    return highlighted + '\n';
  } catch (e) {
    const escapedText = codeText.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    return `<pre><code>${escapedText}</code></pre>\n`;
  }
};

marked.use({ renderer });

// Parsear el contenido markdown a HTML
const htmlContent = marked.parse(markdownContent);
---

<ConsoleLayout title="games/ | sebas">
    <TopBar />
    <DocHero />
    
    <div class="relative z-20 w-full flex-grow flex flex-col items-center px-0 lg:px-8">
        <div class="article-reader-zone w-full max-w-7xl flex flex-col lg:flex-row gap-12 px-6 md:px-12 lg:px-16 py-12 items-start relative z-20">
            
            <!-- Sidebar (Sticky on Desktop) -->
            <aside class="hidden xl:block w-[200px] flex-shrink-0 sticky top-[100px]">
                <ProjectSidebar client:load headings={headings} accentColor="var(--color-accent)" />
            </aside>

            <main id="markdown-content" class="w-full flex-grow flex flex-col pb-12 overflow-x-auto min-w-0 prose prose-p:text-[var(--color-text-muted)] prose-headings:font-mono prose-headings:text-[var(--color-text)] prose-a:text-[var(--color-accent)] prose-a:no-underline hover:prose-a:text-[var(--color-accent)]/80 prose-code:text-[var(--color-accent)] prose-code:bg-[var(--color-surface-dark)] prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-md prose-code:font-medium prose-code:before:content-none prose-code:after:content-none prose-pre:bg-[var(--color-surface-dark)] prose-pre:border prose-pre:border-[var(--color-stroke)] prose-hr:border-[var(--color-stroke)] prose-td:border-[var(--color-stroke)] prose-th:border-[var(--color-stroke)] prose-strong:text-[var(--color-text)] prose-ul:text-[var(--color-text-muted)] prose-li:text-[var(--color-text-muted)] max-w-none prose-table:overflow-x-auto prose-table:block w-full prose-headings:mt-6 prose-headings:mb-4 prose-p:my-2 prose-ul:my-2 prose-li:my-0.5 prose-hr:my-8 prose-img:rounded-xl">
                <Fragment set:html={htmlContent} />
            </main>
        </div>
    </div>

    <DocFooter />
</ConsoleLayout>

<style is:global>
    /* Fix inline images and icons margins/alignments from typography plugin */
    #markdown-content img[align="absmiddle"],
    #markdown-content img[width="14"],
    #markdown-content img[width="16"],
    #markdown-content img[width="18"],
    #markdown-content img[width="20"],
    #markdown-content img[width="24"],
    #markdown-content img[width="32"],
    #markdown-content img[width="40"],
    #markdown-content img[src*="shields.io"],
    #markdown-content img[src*="iconify"] {
        display: inline-block !important;
        margin: 0 !important;
        border: none !important;
        vertical-align: middle !important;
        border-radius: 0 !important;
    }

    /* Remove the direct descendant combinator `>` so it finds images wrapped in anchors */
    #markdown-content p:has(img[src*="shields.io"]) {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: center;
        justify-content: center;
    }

    #markdown-content [align="center"] {
        text-align: center !important;
    }
    
    #markdown-content [align="center"] p {
        text-align: center !important;
        justify-content: center !important;
    }

    #markdown-content [align="center"] h1,
    #markdown-content [align="center"] h2,
    #markdown-content [align="center"] h3,
    #markdown-content [align="center"] h4,
    #markdown-content [align="center"] h5,
    #markdown-content [align="center"] h6 {
        justify-content: center !important;
        text-align: center !important;
        margin-left: 0 !important;
        padding-left: 0 !important;
    }
    
    /* Force table to behave as block element with max-content to center securely */
    #markdown-content [align="center"] table,
    #markdown-content table[align="center"] {
        margin-inline: auto !important;
        display: table !important;
        width: max-content !important;
    }

    /* Scroll horizontal para tablas y elementos anchos */
    #markdown-content table {
        display: block !important;
        overflow-x: auto !important;
        -webkit-overflow-scrolling: touch;
        max-width: 100% !important;
    }

    #markdown-content [align="center"] table,
    #markdown-content table[align="center"] {
        display: table !important;
        max-width: 100% !important;
    }

    #markdown-content pre {
        overflow-x: auto !important;
        max-width: 100% !important;
    }

    #markdown-content .mermaid-container {
        overflow-x: auto !important;
    }

    /* Contenedores div anchos (como ASCII art en <pre>) */
    #markdown-content div {
        max-width: 100%;
        overflow-x: auto;
    }

    #markdown-content tr[align="center"] th,
    #markdown-content tr[align="center"] td,
    #markdown-content [align="center"] th,
    #markdown-content [align="center"] td {
        text-align: center !important;
    }

    /* Override any default prose gray text on tables and general body for excellent readability */
    #markdown-content table, 
    #markdown-content th, 
    #markdown-content td, 
    #markdown-content b, 
    #markdown-content strong,
    #markdown-content p,
    #markdown-content span {
        color: var(--color-text) !important;
    }

    /* Keep main large screenshots bordered if needed, otherwise no border by default to avoid ugly boxes on badges */
    #markdown-content img:not([width]):not([src*="shields.io"]):not([src*="iconify"]) {
        border: 1px solid var(--color-stroke);
    }

    /* Shiki dual-theme configuration */
    .shiki {
        background-color: transparent !important;
    }
    
    html[data-theme$="-light"] .shiki,
    html[data-theme$="-light"] .shiki span {
        color: var(--shiki-light) !important;
        font-style: var(--shiki-light-font-style, normal) !important;
        font-weight: var(--shiki-light-font-weight, normal) !important;
        text-decoration: var(--shiki-light-text-decoration, none) !important;
    }

    html:not([data-theme$="-light"]) .shiki,
    html:not([data-theme$="-light"]) .shiki span {
        color: var(--shiki-dark) !important;
        font-style: var(--shiki-dark-font-style, normal) !important;
        font-weight: var(--shiki-dark-font-weight, normal) !important;
        text-decoration: var(--shiki-dark-text-decoration, none) !important;
    }

    /* Invert white icons when in light modes to ensure visibility */
    html[data-theme$="-light"] #markdown-content img[src*="ffffff" i] {
        filter: invert(1);
    }
    
    /* Make summary/dropdown elements behave as clickable buttons */
    #markdown-content summary {
        cursor: pointer;
        user-select: none;
        transition: color 0.2s ease;
    }

    #markdown-content summary:hover {
        color: var(--color-accent) !important;
    }

    /* Mermaid graph drag cursors */
    .mermaid-container,
    .mermaid-container svg {
        cursor: grab;
    }
    .mermaid-container:active,
    .mermaid-container:active svg,
    .mermaid-container svg:active {
        cursor: grabbing;
    }

    .article-reader-zone {
        background-color: var(--color-bg);
    }
    
    /* Prettify interactive zoom controls (global because injected by js) */
    :global(#svg-pan-zoom-controls) {
        opacity: 0.2;
        transition: opacity 0.4s ease-out !important;
        cursor: pointer;
    }
    :global(#svg-pan-zoom-controls:hover) {
        opacity: 1;
    }

    @media (min-width: 1024px) {
        .article-reader-zone {
            box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.5);
            border: 1px solid var(--color-stroke);
            border-top: none;
            border-radius: 0 0 24px 24px;
            margin-bottom: 2rem;
        }
    }
</style>

<script type="module">
    import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';
    import svgPanZoom from 'https://cdn.jsdelivr.net/npm/svg-pan-zoom@3.6.1/+esm';

    const getMermaidTheme = () => {
        const isLight = document.documentElement.getAttribute('data-theme')?.endsWith('-light');
        return isLight ? 'default' : 'dark';
    };

    const initMermaid = async () => {
        const elements = document.querySelectorAll('.mermaid-container');
        if (elements.length > 0) {
            try {
                mermaid.initialize({ 
                    startOnLoad: false, 
                    theme: getMermaidTheme(),
                    fontFamily: '"JetBrains Mono", monospace'
                });

                for (let i = 0; i < elements.length; i++) {
                    const el = elements[i];
                    const src = el.getAttribute('data-src');
                    if (!src) continue;

                    // Decode HTML entities
                    const txt = document.createElement("textarea");
                    txt.innerHTML = src;
                    const code = txt.value;

                    // Create unique ID for rendering
                    const svgId = `mermaid-svg-${i}-${Date.now()}`;
                    
                    // Render explicitly
                    const { svg, bindFunctions } = await mermaid.render(svgId, code);
                    
                    // Inject and bind
                    el.innerHTML = svg;
                    if (bindFunctions) bindFunctions(el);

                    // Re-apply PanZoom over the new SVG element
                    const newSvgNode = el.querySelector('svg');
                    if (newSvgNode) {
                        newSvgNode.style.height = "100%";
                        newSvgNode.style.width = "100%";
                        newSvgNode.style.maxWidth = "none";
                        
                        svgPanZoom(newSvgNode, {
                            zoomEnabled: true,
                            controlIconsEnabled: true,
                            fit: true,
                            center: true,
                            minZoom: 0.5,
                            maxZoom: 10
                        });
                    }
                }
            } catch (err) {
                console.error("Mermaid parsing failed:", err);
            }
        }
    };

    const themeObserver = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
            if (mutation.attributeName === 'data-theme') {
                initMermaid();
            }
        });
    });

    document.addEventListener('astro:page-load', () => {
        initMermaid();
        themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    });

    // Fallback if not using ViewTransitions
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
            initMermaid();
        });
    } else {
        initMermaid();
    }
</script>

                      "name": "div1",
                      "width": "fill_container",
                      "height": 1,
                      "fill": "#1E2028"
                    },
                    {
                      "type": "text",
                      "id": "y0nDC",
                      "name": "p1",
                      "fill": "#C8CCD4",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Games es una plataforma web de videojuegos desarrollada como proyecto final del grado superior en Desarrollo de Aplicaciones Multiplataforma (DAM). La aplicación permite a los usuarios explorar un catálogo completo de videojuegos, gestionar sus colecciones personales, escribir reseñas y conectar con otros jugadores.",
                      "lineHeight": 1.8,
                      "fontFamily": "IBM Plex Mono",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "evKoB",
                      "name": "p2",
                      "fill": "#C8CCD4",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "El proyecto demuestra una arquitectura fullstack moderna, con un backend robusto en Spring Boot y un frontend interactivo en React, todo orquestado con Docker para facilitar el despliegue.",
                      "lineHeight": 1.8,
                      "fontFamily": "IBM Plex Mono",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "RWUbg",

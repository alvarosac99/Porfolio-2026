                },
                {
                  "type": "text",
                  "id": "YFTCz",
                  "name": "detLead",
                  "fill": "#8B939F",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Quiero montar un servidor dedicado en casa con Proxmox, correr mis propios servicios y aprender a gestionar infraestructura real desde cero.",
                  "lineHeight": 1.75,
                  "fontFamily": "IBM Plex Mono",
                  "fontSize": 16,

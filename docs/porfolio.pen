                  "children": [
                    {
                      "type": "text",
                      "id": "vGpxV",
                      "name": "h1",
                      "fill": "#FAFAFA",
                      "content": "# Descripción",
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 24,

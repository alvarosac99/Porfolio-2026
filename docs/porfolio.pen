                  "children": [
                    {
                      "type": "text",
                      "id": "G4iY5",
                      "name": "h2",
                      "fill": "#FAFAFA",
                      "content": "# Características",
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 24,
                      "fontWeight": "bold"
                    },
                    {
                      "type": "frame",
                      "id": "qovBI",
                      "name": "div2",
                      "width": "fill_container",
                      "height": 1,
                      "fill": "#1E2028"
                    },
                    {
                      "type": "frame",
                      "id": "JDmNt",
                      "name": "featList",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 8,

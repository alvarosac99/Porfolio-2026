                          ]
                        },
                        {
                          "type": "text",
                          "id": "X8CdX",
                          "name": "codeContent",
                          "fill": "#8B939F",
                          "content": "services:\n  nextcloud:   # almacenamiento personal\n  jellyfin:    # media server\n  gitea:       # git auto-alojado\n  vaultwarden: # gestor de contraseñas\n  uptime-kuma: # monitorización\n  nginx-proxy: # reverse proxy",
                          "lineHeight": 1.8,
                          "fontFamily": "JetBrains Mono",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "TG0CN",
                      "name": "p3",
                      "fill": "#CACED6",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "El objetivo final es tener todo esto funcionando de forma estable, con backups automáticos y acceso remoto seguro mediante Tailscale. Nada de servicios en la nube de terceros para lo personal.",
                      "lineHeight": 1.85,
                      "fontFamily": "IBM Plex Mono",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "A8D2u",
                      "name": "p4label",
                      "fill": "#00D4AA",
                      "content": "// hardware previsto",
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 11,
                      "fontWeight": "bold",
                      "letterSpacing": 1
                    },
                    {
                      "type": "frame",

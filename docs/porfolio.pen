                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "const config = {\n  particles: 80,\n  radius_conexion: 120,    // px\n  radius_atraccion: 180,   // px\n  velocidad_idle: 0.3,\n  fuerza_gravedad: 0.05,\n  burst_force: 8,\n  burst_decay: 0.95,\n  line_opacity: 0.4,\n  particle_size: [2, 6],   // min, max\n  color_idle: '#6B5F65',\n  color_active: '#FF7A42',\n  color_lines: '#E8612A',\n}",
                  "lineHeight": 1.7,
                  "fontFamily": "JetBrains Mono",
                  "fontSize": 11,

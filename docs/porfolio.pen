                        {
                          "type": "text",
                          "id": "X4Fou",
                          "name": "p4_desc",
                          "fill": "#4B5563",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Motor de cumplimiento normativo (BOE/UNE) con RAG propio: chunking semántico, embeddings y retrieval implementados sin frameworks. Cliente LLM multi-modelo vía OpenRouter (Claude, Gemini, Llama, DeepSeek) con observabilidad OpenTelemetry.\nMonorepo: IA en Python/FastAPI · backend Java/Quarkus (auth MFA, JWT, billing, conector dataspace Gaia-X/IDS) · AWS Lambda · frontend React/TS.\nProgramador principal: diseño, IA y despliegue completo en AWS (EC2, volúmenes, BBDD, grupos de seguridad).",
                          "fontFamily": "IBM Plex Mono",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "vtV5l",
                          "name": "p4_tags",
                          "fill": "#EA580C",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "[Python]  [FastAPI]  [RAG]  [OpenRouter]  [Quarkus]  [AWS]  [Gaia-X/IDS]",
                          "fontFamily": "IBM Plex Mono",
                          "fontSize": 10,
                          "fontWeight": "normal"
                        }
                      ]
                    },

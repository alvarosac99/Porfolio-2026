              "id": "P10Q2",
              "name": "techStack",
              "fill": "#8A7D84",
              "content": "// stack: SVG inline + vanilla JS · requestAnimationFrame · perlin noise · sin dependencias externas",
              "lineHeight": 1.4,
              "fontFamily": "IBM Plex Mono",
              "fontSize": 11,
              "fontWeight": "normal"

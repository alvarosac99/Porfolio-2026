                }
              ]
            },
            {
              "type": "frame",
              "id": "nUQnf",
              "name": "detCols",
              "width": "fill_container",
              "gap": 56,
              "children": [
                {
                  "type": "frame",
                  "id": "lXojr",
                  "name": "detArticle",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 28,
                  "children": [
                    {
                      "type": "text",
                      "id": "7RwjW",
                      "name": "p1label",
                      "fill": "#00D4AA",
                      "content": "// la idea",
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 11,
                      "fontWeight": "bold",
                      "letterSpacing": 1
                    },
                    {
                      "type": "text",
                      "id": "qQ7ec",
                      "name": "p1",
                      "fill": "#CACED6",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Llevo tiempo pensando en tener un servidor propio en casa. No algo enorme, sino una máquina modesta que pueda correr Proxmox y virtualizar los servicios que más uso. La idea no es solo tenerlo funcionando, sino aprender de verdad cómo se gestiona infraestructura.",
                      "lineHeight": 1.85,
                      "fontFamily": "IBM Plex Mono",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "V3gyw",
                      "name": "p2label",
                      "fill": "#00D4AA",
                      "content": "// servicios que quiero correr",
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 11,
                      "fontWeight": "bold",
                      "letterSpacing": 1
                    },
                    {
                      "type": "frame",
                      "id": "Cgf0p",
